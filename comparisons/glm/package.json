{
  "name": "gitello",
  "version": "0.1.0",
  "description": "A text-driven Trello clone with git storage",
  "type": "module",
  "bin": {
    "gitello": "bin/gitello.js"
  },
  "engineStrict": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "check": "prettier --check . && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@blessed/neo-blessed": "^1.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
