{
  "name": "gitello",
  "version": "0.1.0",
  "description": "A text-driven trello clone with git storage",
  "type": "module",
  "bin": {
    "gitello": "bin/gitello.js"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
